# --- Odoo (external API: XML-RPC at /xmlrpc/2) ---
ODOO_URL=http://localhost:8069
ODOO_DB=odoo
ODOO_USERNAME=admin
# Password or an Odoo API key (Settings > Users > Account Security > New API Key)
ODOO_PASSWORD=admin
ODOO_DB_PASSWORD=odoo

# --- App database (Postgres, separate from Odoo's) ---
APP_DB_PASSWORD=app
APP_DB_PORT=5433
DATABASE_URL=postgres://app:app@localhost:5433/copilot

# --- LLM providers (set the ones you use; never commit real keys) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Model for agent runs as "<provider>:<model-id>", e.g. anthropic:claude-sonnet-5-5
AGENT_MODEL=
NVIDIA_API_KEY=
